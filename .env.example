# 기본값은 전부 무료/로컬(local)로 동작합니다. OpenAI 키가 없어도 됩니다.
EMBEDDING_BACKEND=local
CHAT_BACKEND=local

LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_CHAT_MODEL=Qwen/Qwen2.5-3B-Instruct

# CHAT_BACKEND=ollama 로 바꿔서 쓸 때만 사용
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ↓ 유료(OpenAI)로 전환하고 싶을 때만 채우고 EMBEDDING_BACKEND/CHAT_BACKEND를 openai로 변경
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

CHROMA_DIR=chroma_db
RAW_DATA_PATH=data/raw_documents.json

# ── 공유 DB (Supabase) — 팀원이 같은 계정·대화·검색 데이터를 쓸 때. 설정법: supabase/README.md ──
# DATABASE_URL 을 지우면 로컬 파일(SQLite/Chroma) 모드. 이 값들은 비밀이다: 채팅·커밋·스크린샷에 올리지 않는다.
# DATABASE_URL=postgresql://postgres.<project-ref>:<비밀번호>@aws-0-<region>.pooler.supabase.com:5432/postgres   # 반드시 Session pooler(IPv4)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=            # service_role 키 (PDF Storage 용, 서버 전용)
# SUPABASE_BUCKET_MANUALS=manuals
